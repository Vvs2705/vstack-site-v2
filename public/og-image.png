<svg width="1200" height="630" viewBox="0 0 1200 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1200" height="630" fill="#1E2535"/>
  
  <!-- Gradient overlay -->
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F07028;stop-opacity:0.1" />
      <stop offset="100%" style="stop-color:#F07028;stop-opacity:0" />
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#grad)"/>
  
  <!-- Logo V -->
  <path d="M200 180L300 380L400 180" stroke="#F07028" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="300" cy="400" r="12" fill="#F07028"/>
  
  <!-- Title -->
  <text x="500" y="280" font-family="Arial, sans-serif" font-size="72" font-weight="bold" fill="#FFFFFF">
    V Stack Solution
  </text>
  
  <!-- Subtitle -->
  <text x="500" y="360" font-family="Arial, sans-serif" font-size="36" fill="#94A3B8">
    Transformação Digital com IA e Automação
  </text>
  
  <!-- Domain -->
  <text x="500" y="480" font-family="Arial, sans-serif" font-size="28" fill="#F07028">
    vstack-solution.com.br
  </text>
</svg>
