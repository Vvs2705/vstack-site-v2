<svg width="1920" height="1080" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="alertGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f3460;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a472a;stop-opacity:1" />
    </linearGradient>
  </defs>

  <rect width="1920" height="1080" fill="url(#alertGrad)"/>

  <!-- Header -->
  <rect x="0" y="0" width="1920" height="80" fill="#16213e" stroke="#ff6b6b" stroke-width="2"/>
  <text x="50" y="50" font-size="32" font-weight="bold" fill="#ff6b6b" font-family="Arial">⚠️ Alertas Inteligentes</text>

  <!-- Alert dashboard -->
  <rect x="50" y="100" width="850" height="900" fill="rgba(255, 107, 107, 0.05)" rx="8" stroke="#ff6b6b" stroke-width="1"/>
  <text x="475" y="135" font-size="18" fill="#ff6b6b" font-family="Arial" font-weight="bold">Alertas Ativos</text>

  <!-- Alert filter buttons -->
  <g>
    <rect x="70" y="155" width="100" height="40" fill="#ff6b6b" rx="4" opacity="0.2" stroke="#ff6b6b" stroke-width="1"/>
    <text x="120" y="182" font-size="13" fill="#ff6b6b" text-anchor="middle" font-family="Arial" font-weight="bold">Crítico</text>

    <rect x="185" y="155" width="100" height="40" fill="#ff9500" rx="4" opacity="0.2" stroke="#ff9500" stroke-width="1"/>
    <text x="235" y="182" font-size="13" fill="#ff9500" text-anchor="middle" font-family="Arial">Aviso</text>

    <rect x="300" y="155" width="100" height="40" fill="#00d4ff" rx="4" opacity="0.2" stroke="#00d4ff" stroke-width="1"/>
    <text x="350" y="182" font-size="13" fill="#00d4ff" text-anchor="middle" font-family="Arial">Info</text>

    <rect x="415" y="155" width="100" height="40" fill="#00ff88" rx="4" opacity="0.2" stroke="#00ff88" stroke-width="1"/>
    <text x="465" y="182" font-size="13" fill="#00ff88" text-anchor="middle" font-family="Arial">Resolvido</text>

    <rect x="530" y="155" width="100" height="40" fill="transparent" rx="4" stroke="#ffffff" stroke-width="1" opacity="0.3"/>
    <text x="580" y="182" font-size="13" fill="#ffffff" text-anchor="middle" font-family="Arial">Todos (24)</text>
  </g>

  <!-- Alert items -->
  <!-- Critical Alert 1 -->
  <g>
    <rect x="70" y="220" width="810" height="100" fill="rgba(255, 107, 107, 0.1)" rx="4" stroke="#ff6b6b" stroke-width="2"/>
    <circle cx="100" cy="270" r="8" fill="#ff6b6b"/>
    <text x="130" y="250" font-size="16" fill="#ff6b6b" font-family="Arial" font-weight="bold">Limite de Crédito Excedido</text>
    <text x="130" y="275" font-size="13" fill="#ffffff" font-family="Arial">Sua linha de crédito foi ultrapassada em R$ 2.500. Verifique com urgência.</text>
    <text x="130" y="300" font-size="12" fill="#00d4ff" font-family="Arial">🕐 há 15 minutos</text>
    <rect x="720" y="250" width="60" height="40" fill="#ff6b6b" rx="3" opacity="0.2"/>
    <text x="750" y="275" font-size="12" fill="#ff6b6b" text-anchor="middle" font-family="Arial" font-weight="bold">Crítico</text>
  </g>

  <!-- Warning Alert 1 -->
  <g>
    <rect x="70" y="340" width="810" height="100" fill="rgba(255, 149, 0, 0.1)" rx="4" stroke="#ff9500" stroke-width="2"/>
    <circle cx="100" cy="390" r="8" fill="#ff9500"/>
    <text x="130" y="370" font-size="16" fill="#ff9500" font-family="Arial" font-weight="bold">Faturamento Baixo no Mês</text>
    <text x="130" y="395" font-size="13" fill="#ffffff" font-family="Arial">Seu faturamento está 18% abaixo da média. Verifique os motivos.</text>
    <text x="130" y="420" font-size="12" fill="#00d4ff" font-family="Arial">🕐 há 2 horas</text>
    <rect x="720" y="370" width="60" height="40" fill="#ff9500" rx="3" opacity="0.2"/>
    <text x="750" y="395" font-size="12" fill="#ff9500" text-anchor="middle" font-family="Arial" font-weight="bold">Aviso</text>
  </g>

  <!-- Info Alert 1 -->
  <g>
    <rect x="70" y="460" width="810" height="100" fill="rgba(0, 212, 255, 0.1)" rx="4" stroke="#00d4ff" stroke-width="1"/>
    <circle cx="100" cy="510" r="8" fill="#00d4ff"/>
    <text x="130" y="490" font-size="16" fill="#00d4ff" font-family="Arial" font-weight="bold">Conciliação Completada com Sucesso</text>
    <text x="130" y="515" font-size="13" fill="#ffffff" font-family="Arial">1.247 transações foram reconciliadas automaticamente. Taxa de precisão: 98%</text>
    <text x="130" y="540" font-size="12" fill="#00d4ff" font-family="Arial">🕐 há 5 horas</text>
    <rect x="720" y="490" width="60" height="40" fill="#00d4ff" rx="3" opacity="0.2"/>
    <text x="750" y="515" font-size="11" fill="#00d4ff" text-anchor="middle" font-family="Arial" font-weight="bold">Info</text>
  </g>

  <!-- Info Alert 2 -->
  <g>
    <rect x="70" y="580" width="810" height="100" fill="rgba(0, 212, 255, 0.1)" rx="4" stroke="#00d4ff" stroke-width="1"/>
    <circle cx="100" cy="630" r="8" fill="#00d4ff"/>
    <text x="130" y="610" font-size="16" fill="#00d4ff" font-family="Arial" font-weight="bold">Nova Transação Detectada</text>
    <text x="130" y="635" font-size="13" fill="#ffffff" font-family="Arial">Transferência bancária de R$ 15.800 foi detectada e categorizada automaticamente.</text>
    <text x="130" y="660" font-size="12" fill="#00d4ff" font-family="Arial">🕐 há 8 horas</text>
    <rect x="720" y="610" width="60" height="40" fill="#00d4ff" rx="3" opacity="0.2"/>
    <text x="750" y="635" font-size="11" fill="#00d4ff" text-anchor="middle" font-family="Arial" font-weight="bold">Info</text>
  </g>

  <!-- Resolved Alert -->
  <g>
    <rect x="70" y="700" width="810" height="100" fill="rgba(0, 255, 136, 0.1)" rx="4" stroke="#00ff88" stroke-width="1" opacity="0.5"/>
    <circle cx="100" cy="750" r="8" fill="#00ff88"/>
    <text x="130" y="730" font-size="16" fill="#00ff88" font-family="Arial" font-weight="bold" opacity="0.8">Divergência de Saldo Resolvida</text>
    <text x="130" y="755" font-size="13" fill="#ffffff" font-family="Arial" opacity="0.7">Diferença de R$ 450 foi identificada e ajustada.</text>
    <text x="130" y="780" font-size="12" fill="#00d4ff" font-family="Arial">🕐 há 1 dia</text>
    <rect x="720" y="730" width="60" height="40" fill="#00ff88" rx="3" opacity="0.2"/>
    <text x="750" y="755" font-size="11" fill="#00ff88" text-anchor="middle" font-family="Arial" font-weight="bold">✓ Resolvido</text>
  </g>

  <!-- Right sidebar - Rules -->
  <rect x="950" y="100" width="950" height="900" fill="rgba(0, 212, 255, 0.05)" rx="8" stroke="#00d4ff" stroke-width="1"/>
  <text x="1425" y="135" font-size="18" fill="#00d4ff" font-family="Arial" font-weight="bold">Regras de Alertas Configuradas</text>

  <!-- Rule cards -->
  <!-- Rule 1 -->
  <g>
    <rect x="970" y="160" width="910" height="140" fill="rgba(0, 212, 255, 0.1)" rx="4" border-left="#00d4ff" border-left-width="4"/>
    <text x="1000" y="190" font-size="14" fill="#ffffff" font-family="Arial" font-weight="bold">✓ Limite de Crédito</text>
    <text x="1000" y="215" font-size="12" fill="#ffffff" font-family="Arial">Alerta quando saldo < R$ 10.000 ou limite > 90%</text>
    <text x="1000" y="240" font-size="12" fill="#00d4ff" font-family="Arial">Status: Ativo  |  Frequência: Real-time</text>
    <rect x="1770" y="180" width="90" height="35" fill="#00ff88" rx="3" opacity="0.2"/>
    <text x="1815" y="203" font-size="12" fill="#00ff88" text-anchor="middle" font-family="Arial" font-weight="bold">Ativo</text>
  </g>

  <!-- Rule 2 -->
  <g>
    <rect x="970" y="320" width="910" height="140" fill="rgba(255, 149, 0, 0.1)" rx="4"/>
    <text x="1000" y="350" font-size="14" fill="#ffffff" font-family="Arial" font-weight="bold">✓ Faturamento Anormal</text>
    <text x="1000" y="375" font-size="12" fill="#ffffff" font-family="Arial">Alerta quando receita varia > 25% da média mensal</text>
    <text x="1000" y="400" font-size="12" fill="#00d4ff" font-family="Arial">Status: Ativo  |  Frequência: Diário (8:00 AM)</text>
    <rect x="1770" y="340" width="90" height="35" fill="#00ff88" rx="3" opacity="0.2"/>
    <text x="1815" y="363" font-size="12" fill="#00ff88" text-anchor="middle" font-family="Arial" font-weight="bold">Ativo</text>
  </g>

  <!-- Rule 3 -->
  <g>
    <rect x="970" y="480" width="910" height="140" fill="rgba(255, 107, 107, 0.1)" rx="4"/>
    <text x="1000" y="510" font-size="14" fill="#ffffff" font-family="Arial" font-weight="bold">✓ Transações Grandes</text>
    <text x="1000" y="535" font-size="12" fill="#ffffff" font-family="Arial">Alerta para transações acima de R$ 20.000</text>
    <text x="1000" y="560" font-size="12" fill="#00d4ff" font-family="Arial">Status: Ativo  |  Frequência: Real-time</text>
    <rect x="1770" y="500" width="90" height="35" fill="#00ff88" rx="3" opacity="0.2"/>
    <text x="1815" y="523" font-size="12" fill="#00ff88" text-anchor="middle" font-family="Arial" font-weight="bold">Ativo</text>
  </g>

  <!-- Rule 4 -->
  <g>
    <rect x="970" y="640" width="910" height="140" fill="rgba(0, 212, 255, 0.1)" rx="4"/>
    <text x="1000" y="670" font-size="14" fill="#ffffff" font-family="Arial" font-weight="bold">✓ Conciliação Diária</text>
    <text x="1000" y="695" font-size="12" fill="#ffffff" font-family="Arial">Verifica divergências de saldo automaticamente</text>
    <text x="1000" y="720" font-size="12" fill="#00d4ff" font-family="Arial">Status: Ativo  |  Frequência: Diário (9:00 PM)</text>
    <rect x="1770" y="660" width="90" height="35" fill="#00ff88" rx="3" opacity="0.2"/>
    <text x="1815" y="683" font-size="12" fill="#00ff88" text-anchor="middle" font-family="Arial" font-weight="bold">Ativo</text>
  </g>

  <!-- Add rule button -->
  <rect x="1650" y="820" width="180" height="50" fill="#00d4ff" rx="4" opacity="0.2" stroke="#00d4ff" stroke-width="1"/>
  <text x="1740" y="852" font-size="14" fill="#00d4ff" text-anchor="middle" font-family="Arial" font-weight="bold">+ Criar Regra</text>
</svg>