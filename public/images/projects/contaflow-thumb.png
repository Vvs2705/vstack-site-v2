<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00d4ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0099cc;stop-opacity:1" />
    </linearGradient>
  </defs>

  <rect width="1200" height="630" fill="url(#grad1)"/>

  <!-- Logo area -->
  <rect x="50" y="50" width="100" height="100" fill="url(#grad2)" rx="10"/>
  <text x="100" y="120" font-size="60" font-weight="bold" fill="white" text-anchor="middle" font-family="Arial">CF</text>

  <!-- Title -->
  <text x="200" y="110" font-size="48" font-weight="bold" fill="white" font-family="Arial">ContaFlow</text>
  <text x="200" y="150" font-size="24" fill="#00d4ff" font-family="Arial">Automação Financeira</text>

  <!-- Dashboard preview area -->
  <rect x="50" y="200" width="1100" height="350" fill="#0f3460" stroke="#00d4ff" stroke-width="2" rx="8" opacity="0.5"/>

  <!-- Mock chart -->
  <rect x="100" y="250" width="400" height="200" fill="#1a472a" rx="4" opacity="0.6"/>
  <text x="300" y="280" font-size="18" fill="#00d4ff" text-anchor="middle" font-family="Arial" font-weight="bold">Fluxo de Caixa</text>

  <!-- Mock bars -->
  <rect x="130" y="350" width="30" height="80" fill="#00d4ff" rx="2"/>
  <rect x="180" y="330" width="30" height="100" fill="#00ff88" rx="2"/>
  <rect x="230" y="310" width="30" height="120" fill="#00d4ff" rx="2"/>
  <rect x="280" y="340" width="30" height="90" fill="#00ff88" rx="2"/>
  <rect x="330" y="320" width="30" height="110" fill="#00d4ff" rx="2"/>

  <!-- Stats boxes -->
  <g>
    <rect x="550" y="250" width="200" height="80" fill="#00d4ff" rx="4" opacity="0.15" stroke="#00d4ff" stroke-width="1"/>
    <text x="650" y="275" font-size="14" fill="#00d4ff" text-anchor="middle" font-family="Arial">Precisão</text>
    <text x="650" y="305" font-size="32" fill="#00d4ff" text-anchor="middle" font-family="Arial" font-weight="bold">98%</text>
  </g>

  <g>
    <rect x="800" y="250" width="200" height="80" fill="#00ff88" rx="4" opacity="0.15" stroke="#00ff88" stroke-width="1"/>
    <text x="900" y="275" font-size="14" fill="#00ff88" text-anchor="middle" font-family="Arial">Economia</text>
    <text x="900" y="305" font-size="28" fill="#00ff88" text-anchor="middle" font-family="Arial" font-weight="bold">R$ 15k</text>
  </g>

  <!-- Features list -->
  <g>
    <circle cx="120" cy="420" r="4" fill="#00d4ff"/>
    <text x="140" y="425" font-size="16" fill="#ffffff" font-family="Arial">Integração Bancária</text>

    <circle cx="120" cy="460" r="4" fill="#00ff88"/>
    <text x="140" y="465" font-size="16" fill="#ffffff" font-family="Arial">Conciliação Automática</text>

    <circle cx="650" cy="420" r="4" fill="#00d4ff"/>
    <text x="670" y="425" font-size="16" fill="#ffffff" font-family="Arial">Relatórios em Tempo Real</text>

    <circle cx="650" cy="460" r="4" fill="#00ff88"/>
    <text x="670" y="465" font-size="16" fill="#ffffff" font-family="Arial">Alertas Inteligentes</text>
  </g>
</svg>