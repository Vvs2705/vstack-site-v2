# Site Configuration
NEXT_PUBLIC_SITE_URL=https://vstack-solutions.com.br

# Database (PostgreSQL - ex: Neon, Supabase, Railway)
DATABASE_URL=postgresql://user:password@host:5432/vstack_db?sslmode=require

# Redis (Upstash - https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Email (Resend - https://resend.com)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=contato@vstack-solutions.com.br
LEADS_EMAIL=vsouz009@gmail.com

# Admin Authentication
JWT_SECRET=seu_secret_aqui_minimo_32_caracteres_aleatorios

# Google Search Console (após verificação)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics (opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Builder.io - Editor visual drag-and-drop (https://builder.io)
# 1. Crie conta gratuita em builder.io
# 2. Crie um Space → Settings → Public API Key
# 3. Cole a chave abaixo
NEXT_PUBLIC_BUILDER_API_KEY=sua_public_api_key_aqui
