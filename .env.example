# Site Configuration
NEXT_PUBLIC_SITE_URL=https://vstack-solution.com.br

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vstack_db

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=contato@vstack-solution.com.br

# Admin Authentication
ADMIN_JWT_SECRET=your_jwt_secret_here_min_32_chars
ADMIN_JWT_EXPIRES_IN=7d

# Google Search Console (após verificação)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code

# Analytics (opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
